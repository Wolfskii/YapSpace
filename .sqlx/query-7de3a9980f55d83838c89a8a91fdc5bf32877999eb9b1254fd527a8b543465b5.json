{
  "db_name": "PostgreSQL",
  "query": "SELECT s.id AS session_id, s.user_id, u.username, u.role, u.status, u.suspended_until, u.created_at\n           FROM sessions s JOIN users u ON u.id = s.user_id\n           WHERE s.token_hash = $1 AND s.revoked_at IS NULL AND s.expires_at > now() AND u.status <> 'deleted'",
