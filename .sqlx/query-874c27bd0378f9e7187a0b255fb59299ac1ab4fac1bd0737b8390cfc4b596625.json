  "db_name": "PostgreSQL",
  "query": "SELECT id, reporter_id, target_type, target_id, reason, details, status, created_at,\n                resolved_by, resolved_at\n         FROM reports\n         WHERE status = 'open'\n           AND ($1::timestamptz IS NULL OR (created_at, id) > ($1, $2::uuid))\n         ORDER BY created_at, id\n         LIMIT $3",
