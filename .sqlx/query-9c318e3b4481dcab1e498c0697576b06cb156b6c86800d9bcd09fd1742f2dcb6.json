{
  "db_name": "PostgreSQL",
  "query": "SELECT m.id, m.created_at, d.display_url AS discussion_display_url, m.seq, m.body, m.status, m.edited_at\n         FROM messages m JOIN discussions d ON d.id = m.discussion_id\n         WHERE m.author_id = $1\n           AND ($2::timestamptz IS NULL OR (m.created_at, m.id) > ($2, $3::uuid))\n         ORDER BY m.created_at, m.id\n         LIMIT $4",
