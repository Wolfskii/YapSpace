{
  "name": "yapspace-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "YapSpace browser extension (Chromium and Firefox, Manifest V3)",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "prepare:wxt": "wxt prepare",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "types:api": "openapi-typescript ../docs/api/openapi.json -o src/lib/api/schema.d.ts"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@testing-library/svelte": "5.4.2",
    "@wxt-dev/module-svelte": "2.0.5",
    "jsdom": "26.1.0",
    "openapi-typescript": "7.13.0",
    "svelte": "5.57.3",
    "svelte-check": "4.7.7",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "wxt": "0.21.5"
  }
}
